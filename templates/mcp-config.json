{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "serena": {
      "type": "stdio",
      "command": "/usr/bin/setpriv",
      "args": [
        "--pdeathsig",
        "TERM",
        "/usr/local/bin/serena",
        "start-mcp-server",
        "--context",
        "claude-code"
      ]
    }
  }
}
